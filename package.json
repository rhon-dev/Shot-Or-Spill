{
  "name": "shot-or-spill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shot or Spill: a Filipino barkada drinking card game for adults (18+).",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:cards && vite build && tsx scripts/build-sw.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:cards": "tsx scripts/validate-cards.ts",
    "card": "tsx scripts/find-card.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check": "npm run typecheck && npm run validate:cards && npm run check:contrast && npm run test",
    "size": "tsx scripts/check-size.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mocks": "tsx scripts/render-mocks.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
