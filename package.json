{
  "name": "shot-or-spill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shot or Spill: a Filipino barkada drinking card game for adults (18+).",
  "scripts": {
    "validate:cards": "tsx scripts/validate-cards.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "mocks": "tsx scripts/render-mocks.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run validate:cards && npm run check:contrast"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
